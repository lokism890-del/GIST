GROQ_API_KEY=your_groq_api_key_here

# WhatsApp Cloud API — from developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Any random string YOU choose — you'll enter this same value into Meta's
# webhook configuration screen. Meta sends it back to prove the handshake.
WHATSAPP_VERIFY_TOKEN=choose_any_random_string_here

# Polar (payments) — from polar.sh dashboard > Settings > Developers
# Use a sandbox token first for testing; POLAR_ENVIRONMENT defaults to
# sandbox unless explicitly set to "production".
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_ENVIRONMENT=sandbox
POLAR_GIST_PRO_PRODUCT_ID=your_gist_pro_product_id_here
